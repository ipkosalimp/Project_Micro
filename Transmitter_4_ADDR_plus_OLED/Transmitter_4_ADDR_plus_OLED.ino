void setup() {
   display.setTextSize(1); // Draw 2X-scale text(1=7px, 2=14px it means 2 times from the pixel)
  display.setTextColor(WHITE);
  display.cp437(true);         // Use full 256 char 'Code Page 437' font
  display.clearDisplay();
  // SSD1306_SWITCHCAPVCC = generate display voltage from 3.3V internally
  if(!display.begin(SSD1306_SWITCHCAPVCC, 0x3C)) { // Address 0x3C for 128x32
    Serial.println(F("SSD1306 allocation failed"));
    for(;;); // Don't proceed, loop forever
  }
  display.drawBitmap(0,0,logo_bmp,128,64,1);
  display.display();
  delay(1000);
  display.clearDisplay();

 splash();

  display.setTextSize(2); // Draw 2X-scale text(1=7px, 2=14px it means 2 times from the pixel)
  display.setTextColor(WHITE);  
  display.setCursor(5, 0);      //Draw the coordinate (x,y);
  display.println("REMOTE RC");
  
  pinMode(tombol,INPUT_PULLUP);
  pinMode(tombol2,INPUT_PULLUP);
  pinMode(pinMod,INPUT_PULLUP);
  pinMode(pinUp,INPUT_PULLUP);
  pinMode(pinDown,INPUT_PULLUP);
  pinMode(pinLeft,INPUT_PULLUP);
  pinMode(pinRight,INPUT_PULLUP);
  pinMode(pinKick,INPUT_PULLUP);
  
  rf24.begin();
  rf24.openWritingPipe(alamat);
  rf24.setPALevel(RF24_PA_LOW);
  rf24.stopListening();
  Serial.begin(9600);
}

void loop() {
  mod=digitalRead(pinMod);

  if(mod==0){
    tmr=0;
    while(mod==0){
       mod=digitalRead(pinMod);
       tmr=tmr+1;
       delay(1);
        if(tmr>2000){
          mod_F=1;
          setAddr();
        }
          
    }
    
  checkaddr();
  tmr=0;
  }

    
  int bacaTombol,bacaTombol2;
  bacaTombol=digitalRead(tombol);
  bacaTombol2=digitalRead(tombol2);
  if(bacaTombol==0) pesan[0]={1};
  else if(bacaTombol2==0) pesan[0]={2};
  else if(bacaTombol==1 && bacaTombol2==1)pesan[0]={0};
  if(bacaTombol==0 && bacaTombol2==0) {
    pesan[0]={3};
   }
  //else if(bacaTombol2==0) pesan[0]={2};
  //else if(bacaTombol2==1) pesan[0]={3};
  
  //pesan[0]=bacaTombol;
  Serial.print(bacaTombol);
  Serial.print("  ");
  Serial.print(bacaTombol2);
  Serial.print("  ");
  Serial.print(pesan[0]);
   Serial.print("  ");
   Serial.println(sizeof(alamat));
  rf24.write(pesan,4);



  checkbat_remot();
  display.display();  //Use this after use the script

  delay(10);
}

