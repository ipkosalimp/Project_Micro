void checkaddr(){
  display.clearDisplay();
  display.setCursor(5, 0);      //Draw the coordinate (x,y);
  display.println("REMOTE RC");
  
  
  display.setCursor(0,16);
  display.print("RC ADDRS :");
  display.setCursor(40,32);
  display.print(alamat);
  display.display();  //Use this after use the scrip
  delay(1000);
}

void setAddr(){

      while(mod_F==1){
         display.clearDisplay();
         display.setCursor(5, 0);      //Draw the coordinate (x,y);
         display.println("REMOTE RC");
          readpin();
          
          if(up_btn==0){
            select=select+1;
            delay(500);
          }
          if(dwn_btn==0){
            select=select-1;
            delay(500);
          }
          if(select>1) select=1;
          if(select<0) select=0;
          if(select==0){
            if(rgt_btn==0){
              mainch=mainch+1;
              delay(50);
            }
              if(lft_btn==0){
              mainch=mainch-1;
              delay(50);
            }
            if(mainch>255) {mainch=1;}
            else if(mainch<1) {mainch=255;}
          }
          if(select==1){
            if(rgt_btn==0){
              subch=subch+1;
              delay(50);
            }
              if(lft_btn==0){
              subch=subch-1;
              delay(50);
            }
            if(subch>255) {subch=1;}
            else if(subch<0) {subch=255;}
          }
        
          display.setCursor(0,16);
          display.print("-Set ADRS-");
          display.setCursor(0,32);
          display.print("MainCh:");
          display.print(mainch);
          display.setCursor(0,48);
          display.print("SubCh:");
          display.print(subch);
          display.display();

          Serial.print("  select= ");
          Serial.print(select);
                    Serial.print("  main= ");
          Serial.print(mainch);
                    Serial.print("  sub= ");
          Serial.println(subch);
          delay(10);
          
          
  }
}

void readpin(){
  mod_btn=digitalRead(pinMod);
  up_btn=digitalRead(pinUp);
  dwn_btn=digitalRead(pinDown);
  lft_btn=digitalRead(pinLeft);
  rgt_btn=digitalRead(pinRight);
  
}
